SF_BASE_URL=https://orgfarm-80a620fbaf-dev-ed.develop.my.salesforce.com
SF_USERNAME=your-configuration-administrator@example.com
# Business tests use Sales Manager; administration never uses this identity.
SF_SALES_USERNAME=e2e.sales.manager.your-org-id@example.invalid
SF_SERVICE_USERNAME=e2e.service.manager.your-org-id@example.invalid
# One-time External Client App provisioning: AUTH_SETUP.md
SF_CLIENT_ID=
SF_JWT_PRIVATE_KEY_FILE=.e2e-auth/jwt.key
# CI: raw multiline PEM in a repository secret (instead of a key file).
SF_JWT_PRIVATE_KEY=
# Developer Edition uses login.salesforce.com; sandboxes use test.salesforce.com.
SF_JWT_AUDIENCE=https://login.salesforce.com

# chatgpt: authenticate once with npx e2e login openai
# Optional test:ai only; the normal UI regression needs no model credentials.
# gateway: set AI_GATEWAY_API_KEY
E2E_ENABLE_AI=0
E2E_MODEL_PROVIDER=chatgpt
E2E_MODEL=gpt-6-luna
AI_GATEWAY_API_KEY=
E2E_TELEMETRY_DISABLED=1

# Salesforce Lightning, English UI. Adapt these to the org's sales process.
SF_OPPORTUNITY_RECORD_TYPE=
SF_STAGE_INITIAL=Prospecting
SF_STAGE_QUALIFIED=Qualification
SF_STAGE_PROPOSAL=Proposal/Price Quote
SF_STAGE_NEGOTIATION=Negotiation/Review
SF_STAGE_WON=Closed Won
SF_STAGE_LOST=Closed Lost
SF_WON_PROBABILITY=100
SF_LOST_PROBABILITY=0

# Match the timezone configured on both Salesforce personas.
SF_TIME_ZONE=Europe/Budapest

# Allure publishing to an owned Netlify report site. Never commit real tokens.
# Locally: Netlify CLI login is sufficient; CI requires NETLIFY_AUTH_TOKEN.
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=
